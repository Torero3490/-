class Student:
    def __init__(self, name, surname, gender):
        self.name = name
        self.surname = surname
        self.gender = gender
        self.finished_courses = []
        self.courses_in_progress = []
        self.grades = {}

    def rate_lecture(self, lecturer, course, grade):
        # Проверяем, что объект — именно Lecturer
        if not isinstance(lecturer, Lecturer):
            raise TypeError("Оценивать можно только лекторов (Lecturer).")

        # Проверяем, что лектор прикреплён к этому курсу
        if course not in lecturer.courses_attached:
            raise ValueError(f"Лектор не ведёт курс '{course}'.")

        # Проверяем, что студент учится на этом курсе
        if course not in self.courses_in_progress:
            raise ValueError(f"Студент не учится на курсе '{course}'.")

        # Проверка диапазона оценки
        if not (0 <= grade <= 10):
            raise ValueError("Оценка должна быть в диапазоне от 0 до 10.")

        # Добавляем оценку в словарь лектора
        if course not in lecturer.grades:
            lecturer.grades[course] = []
        lecturer.grades[course].append(grade)

        return None


class Mentor:
    def __init__(self, name, surname):
        self.name = name
        self.surname = surname
        self.courses_attached = []


class Lecturer(Mentor):
    def __init__(self, name, surname):
        super().__init__(name, surname)
        self.grades = {}  # {course: [list of grades]}


class Reviewer(Mentor):
    # У Reviewer нет grades, он только проверяет ДЗ
    pass


# Пример использования
lecturer = Lecturer('Иван', 'Иванов')
reviewer = Reviewer('Пётр', 'Петров')
student = Student('Алёхина', 'Ольга', 'Ж')

student.courses_in_progress += ['Python', 'Java']
lecturer.courses_attached += ['Python', 'C++']
reviewer.courses_attached += ['Python', 'C++']

print(student.rate_lecture(lecturer, 'Python', 7))   # None
# print(student.rate_lecture(lecturer, 'Java', 8))     # ValueError: Студент не учится на курсе 'Java'
# print(student.rate_lecture(lecturer, 'С++', 8))      # ValueError: Студент не учится на курсе 'С++'
# print(student.rate_lecture(reviewer, 'Python', 6))   # TypeError: Оценивать можно только лекторов (Lecturer).

print(lecturer.grades)  # {'Python': [7]}
